* text=auto

# Keep source files and the Unix wrapper portable.
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
/gradlew text eol=lf
*.bat text eol=crlf

# Binary assets and the Gradle wrapper JAR.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
